#!/usr/bin/env bash
# First-time setup: create the virtual environment, install dependencies, and
# download the one MediaPipe hand model. Run once, then ./train-gestures, then ./start.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"
VENV="$ROOT/.venv"

# MediaPipe ships wheels for CPython 3.11-3.13 only. The system's default
# python3 here is 3.14, which has no wheels, so pick a compatible interpreter.
pick_python() {
  for candidate in python3.11 python3.12 python3.13; do
    if command -v "$candidate" >/dev/null 2>&1; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

if [ ! -d "$VENV" ]; then
  if ! PYTHON="$(pick_python)"; then
    echo "ERROR: need python3.11, 3.12, or 3.13 (mediapipe has no wheels for 3.14+)." >&2
    echo "Install one, e.g.  brew install python@3.11" >&2
    exit 1
  fi
  echo "==> Creating virtual environment with $PYTHON"
  "$PYTHON" -m venv "$VENV"
else
  echo "==> Reusing existing virtual environment (.venv)"
fi

# shellcheck disable=SC1091
source "$VENV/bin/activate"

echo "==> Upgrading pip"
python -m pip install --upgrade pip

echo "==> Installing dependencies (this can take a few minutes)"
python -m pip install -r requirements.txt

echo "==> Downloading the hand-detection model"
python src/setup_assets.py

echo "==> Downloading the voice models (Vosk speech + Piper voice, ~100 MB)"
python src/setup_voice.py

echo "==> Generating filler music (royalty-free placeholders for the demo)"
python src/make_filler_music.py || echo "WARNING: could not generate filler music."

echo "==> Building the web UI (React + shadcn/ui)"
if command -v npm >/dev/null 2>&1; then
  ( cd "$ROOT/web" && npm install && npm run build )
else
  echo "WARNING: npm not found — the browser UI will not be built."
  echo "         Install Node.js 18+, then run:  cd web && npm install && npm run build"
fi

echo
echo "Setup complete (camera + voice models installed)."
echo "  Next: ./train-gestures   # capture the 5 gestures and train the model"
echo "  Then: ./start            # open the web UI (camera + hold-to-talk voice)"
echo
echo "  Optional: for real conversation, install Ollama and run:"
echo "    ollama create spis-robot -f config/spis-robot.Modelfile"
echo "  Without it, the robot uses built-in rule replies automatically."
